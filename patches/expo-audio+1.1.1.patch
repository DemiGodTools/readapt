+  /**
+   * Publishes title/artist/album/artwork onto the player's current MediaItem so
+   * the MediaSession (and therefore the system media player, lock screen and
+   * Bluetooth) reports real metadata instead of "Unknown song" with no cover.
+   */
+  private fun applyMediaMetadataToPlayer(player: AudioPlayer, metadata: Metadata?) {
+    if (metadata == null) return
+    val item = player.ref.currentMediaItem ?: return
+    val existing = item.mediaMetadata
+
+    val builder = existing.buildUpon()
+    metadata.title?.takeIf { it.isNotBlank() }?.let { builder.setTitle(it) }
+    metadata.artist?.takeIf { it.isNotBlank() }?.let { builder.setArtist(it) }
+    metadata.albumTitle?.takeIf { it.isNotBlank() }?.let { builder.setAlbumTitle(it) }
+    metadata.artworkUrl?.let { builder.setArtworkUri(Uri.parse(it.toString())) }
+
+    val updated = builder.build()
+    if (updated == existing) return
+
+    // Preserve the current playback position across the media item swap
+    val positionMs = player.ref.currentPosition
+    val playWhenReady = player.ref.playWhenReady
+    try {
+      player.ref.replaceMediaItem(
+        player.ref.currentMediaItemIndex,
+        item.buildUpon().setMediaMetadata(updated).build()
+      )
+      player.ref.seekTo(positionMs)
+      if (playWhenReady) player.ref.play()
+    } catch (_: Exception) {}
+  }
